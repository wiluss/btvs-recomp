+static uint32_t import_launch_page(const char *path)
+{
+    uint8_t buffer[4096];
+    FILE *file = fopen(path, "rb");
+    uint32_t page;
+    int valid;
+
+    if (!file)
+        return 0;
+    valid = fread(buffer, 1, sizeof buffer, file) == sizeof buffer &&
+            fgetc(file) == EOF && !ferror(file);
+    fclose(file);
+    if (!valid)
+        return 0;
+    page = xbox_ContiguousAlloc(sizeof buffer, sizeof buffer);
+    if (page)
+        memcpy(XBOX_TO_NATIVE(page), buffer, sizeof buffer);
+    return page;
+}
+
+static void export_launch_page(uint32_t page)
+{
+    const char *path = recomp_env(RENV_LAUNCH_PAGE_OUT);
+    FILE *file;
+    int valid;
+
+    if (!path || !*path)
+        return;
+    if (page % 4096 || !bridge_va_mapped(page, 4096) || !(file = fopen(path, "wb"))) {
+        fprintf(stderr, "[RELAUNCH] could not save launch page\n");
+        return;
+    }
+    valid = fwrite(XBOX_TO_NATIVE(page), 1, 4096, file) == 4096;
+    if (fclose(file) || !valid) {
+        remove(path);
+        fprintf(stderr, "[RELAUNCH] could not write complete launch page\n");
+    }
+}
