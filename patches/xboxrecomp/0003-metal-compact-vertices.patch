diff --git a/src/kernel/nv2a_vertex_metrics.h b/src/kernel/nv2a_vertex_metrics.h
new file mode 100644
index 0000000..d132062
--- /dev/null
+++ b/src/kernel/nv2a_vertex_metrics.h
@@ -0,0 +1,27 @@
+/* Optional Metal vertex metrics. Single render thread, no guest memory cache. */
+#ifndef NV2A_VERTEX_METRICS_H
+#define NV2A_VERTEX_METRICS_H
+#include <stdint.h>
+#include <string.h>
+
+static uint32_t vertex_unique(const uint32_t *idx, uint32_t n, uint32_t span)
+{
+    static uint64_t bits[1024];
+    uint32_t unique = 0;
+    if (span > 65536u)
+        return UINT32_MAX;
+    memset(bits, 0, (size_t)((span + 63u) / 64u) * sizeof bits[0]);
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t v = idx[i];
+        uint64_t bit;
+        if (v >= span)
+            return UINT32_MAX;
+        bit = UINT64_C(1) << (v & 63u);
+        if (!(bits[v >> 6] & bit)) {
+            bits[v >> 6] |= bit;
+            unique++;
+        }
+    }
+    return unique;
+}
+#endif
diff --git a/src/kernel/nv2a_vertex_compact.h b/src/kernel/nv2a_vertex_compact.h
new file mode 100644
index 0000000..bd0b109
--- /dev/null
+++ b/src/kernel/nv2a_vertex_compact.h
@@ -0,0 +1,43 @@
+/* Intra-draw vertex index compaction. Never cache guest vertex contents. */
+#ifndef NV2A_VERTEX_COMPACT_H
+#define NV2A_VERTEX_COMPACT_H
+#include <stdint.h>
+#include <string.h>
+
+struct nv2a_vertex_map {
+    uint64_t seen[1024];
+    uint16_t source[65536];
+    uint16_t remap[65536];
+};
+
+/* Indices are relative to the draw's minimum index. Failure/dense fallback
+ * leaves all indices unchanged. Source IDs and remap IDs both fit uint16,
+ * including the last ID of a 65536-vertex span. Caller owns the scratch. */
+static int nv2a_vertex_compact(uint32_t *idx, uint32_t n, uint32_t span,
+                                struct nv2a_vertex_map *work, uint32_t *packed)
+{
+    uint32_t unique = 0;
+    *packed = span;
+    if (!span || span > 65536u || !n)
+        return 0;
+    memset(work->seen, 0, (size_t)((span + 63u) / 64u) * sizeof work->seen[0]);
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t v = idx[i];
+        uint64_t bit;
+        if (v >= span)
+            return 0;
+        bit = UINT64_C(1) << (v & 63u);
+        if (!(work->seen[v >> 6] & bit)) {
+            work->seen[v >> 6] |= bit;
+            work->source[unique] = (uint16_t)v;
+            work->remap[v] = (uint16_t)unique++;
+        }
+    }
+    if (unique * 4u > span * 3u)
+        return 0;
+    for (uint32_t i = 0; i < n; i++)
+        idx[i] = work->remap[idx[i]];
+    *packed = unique;
+    return 1;
+}
+#endif
