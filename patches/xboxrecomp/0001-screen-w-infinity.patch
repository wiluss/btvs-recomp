diff --git a/src/kernel/nv2a_screen_w.h b/src/kernel/nv2a_screen_w.h
new file mode 100644
--- /dev/null
+++ b/src/kernel/nv2a_screen_w.h
@@ -0,0 +1,16 @@
+#ifndef NV2A_SCREEN_W_H
+#define NV2A_SCREEN_W_H
+
+#include <math.h>
+
+/* Normalise l'épilogue w : préserve 0→1, borne ±inf vers ±2^64, laisse NaN.
+ * Provenance : adaptation documentée du clamp xemu [2^-64, 2^64],
+ * restreinte ici à l'infini pour préserver le chemin rapide w=0. */
+static inline float nv2a_screen_w(float w) {
+    if (w == 0.0f) return 1.0f;
+    /* Clamp ±inf to ±2^64 (exact float32 representation 0x5F800000), preserving sign. */
+    if (isinf(w)) return copysignf(0x1p64f, w);
+    return w;
+}
+
+#endif /* NV2A_SCREEN_W_H */
