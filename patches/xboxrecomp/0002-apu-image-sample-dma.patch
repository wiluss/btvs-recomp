+/* Sample DMA has an additional explicit source: a PCM buffer in the loaded
+ * image, named through MmGetPhysicalAddress. A later contiguous allocation
+ * may reuse its physical number. Keep descriptor/SGE/notifier reads on the
+ * existing resolver: those structures still belong to the window. Heap
+ * ownership, high RAM and wrapping retain the existing rules. */
+uint8_t *mcpx_apu_sample_phys(uint64_t addr)
+{
+    uint32_t a = (uint32_t)addr & 0x0FFFFFFFu;
+    if (a < (64u << 20) && xbox_PhysImageNameMap()[a >> 12])
+        return g_apu_ram_ptr + a;
+    return mcpx_apu_phys(addr);
+}
+
+const char *mcpx_apu_sample_phys_class(uint64_t addr)
+{
+    uint32_t a = (uint32_t)addr & 0x0FFFFFFFu;
+    if (a < (64u << 20) && xbox_PhysImageNameMap()[a >> 12])
+        return "image-named";
+    return mcpx_apu_phys_class(addr);
+}
+
