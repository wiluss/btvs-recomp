+/* Optional title-owned HUD placement for Metal Hor+. No guest state is changed.
+ * Part of XboxRecomp; the repository's MIT notice applies. */
+#ifndef NV2A_HUD_ANCHOR_H
+#define NV2A_HUD_ANCHOR_H
+#include <stdint.h>
+
+struct nv2a_hud_anchor_info {
+    uint64_t texture_hash; /* Successfully uploaded guest texels; zero: unavailable. */
+    uint32_t program_hash, format, texture_width, texture_height;
+    uint32_t width, height, pad, scale;
+    int two_d, place; /* place 0: existing CENTRE mapping. */
+    uint32_t vertex_count;
+    int bounds_valid;
+    float lo_x, hi_x, lo_y, hi_y; /* Existing orthographic scan, in guest surface pixels. */
+};
+/* -1: left edge; 0: original centre; +1: right edge. Other values ignored.
+ * Callback must be immutable/thread-safe and remain alive until unset. */
+typedef int (*nv2a_hud_anchor_fn)(const struct nv2a_hud_anchor_info *);
+void nv2a_hud_anchor_set(nv2a_hud_anchor_fn fn);
+int nv2a_hud_anchor_active(void);
+int nv2a_hud_anchor_dx(const struct nv2a_hud_anchor_info *b);
+float nv2a_hud_anchor_delta(uint32_t width, uint32_t pad, int dx);
+void nv2a_hud_anchor_box(uint32_t box[4], uint32_t width, uint32_t pad,
+                         unsigned scale, int dx);
+#endif
diff --git a/src/kernel/nv2a_hud_anchor.c b/src/kernel/nv2a_hud_anchor.c
new file mode 100644
--- /dev/null
+++ b/src/kernel/nv2a_hud_anchor.c
@@ -0,0 +1,54 @@
+/* Optional Metal HUD placement; see nv2a_hud_anchor.h. */
+#include "nv2a_hud_anchor.h"
+#include <stddef.h>
+#include <stdatomic.h>
+
+static _Atomic(nv2a_hud_anchor_fn) s_anchor;
+
+void nv2a_hud_anchor_set(nv2a_hud_anchor_fn fn)
+{
+    atomic_store_explicit(&s_anchor, fn, memory_order_release);
+}
+
+int nv2a_hud_anchor_active(void)
+{
+    return atomic_load_explicit(&s_anchor, memory_order_acquire) != NULL;
+}
+
+int nv2a_hud_anchor_dx(const struct nv2a_hud_anchor_info *b)
+{
+    nv2a_hud_anchor_fn fn;
+    int a;
+    if (!b || !b->two_d || b->place || !b->texture_hash
+        || !b->width || !b->height || !b->pad || b->pad > 16384u
+        || b->width > 16384u || b->height > 16384u
+        || b->scale < 1 || b->scale > 4)
+        return 0;
+    fn = atomic_load_explicit(&s_anchor, memory_order_acquire);
+    if (!fn)
+        return 0;
+    a = fn(b);
+    return a == -1 ? -(int)b->pad : a == 1 ? (int)b->pad : 0;
+}
+
+float nv2a_hud_anchor_delta(uint32_t width, uint32_t pad, int dx)
+{
+    return dx ? (float)(2.0 * dx / ((double)width + 2.0 * pad)) : 0.0f;
+}
+
+static uint32_t clip_x(int64_t x, int64_t limit)
+{
+    return (uint32_t)(x < 0 ? 0 : x > limit ? limit : x);
+}
+
+void nv2a_hud_anchor_box(uint32_t box[4], uint32_t width, uint32_t pad,
+                         unsigned scale, int dx)
+{
+    int64_t shift, limit;
+    if (!dx)
+        return;
+    shift = (int64_t)dx * scale;
+    limit = ((int64_t)width + 2 * (int64_t)pad) * scale;
+    box[0] = clip_x((int64_t)box[0] + shift, limit);
+    box[2] = clip_x((int64_t)box[2] + shift, limit);
+}
