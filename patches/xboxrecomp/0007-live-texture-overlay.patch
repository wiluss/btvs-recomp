+/* Caller: walker flip or startup, never a UI/input thread. Parsing builds
+ * an isolated candidate: a missing/bad file preserves both current layers. */
+int nv2a_tex_pack_overlay_load(const char *path, char *err, size_t errlen)
+{
+    struct pack_state candidate = {0};
+    int count;
+    s_target = &candidate;
+    count = nv2a_tex_pack_load(path, err, errlen);
+    s_target = &s_base;
+    if (count < 0) return -1;
+    for (unsigned i = 0, j = 0; i < candidate.count; i++) {
+        struct nv2a_tex_pack_entry *a = &candidate.entries[i];
+        while (j < s_base.count && s_base.entries[j].hash < a->hash) j++;
+        if (j < s_base.count && s_base.entries[j].hash == a->hash) {
+            struct nv2a_tex_pack_entry *b = &s_base.entries[j];
+            if (a->kind != b->kind || (uint64_t)a->width*b->height != (uint64_t)b->width*a->height) {
+                s_target = &candidate; nv2a_tex_pack_unload(); s_target = &s_base;
+                fail(err, errlen, "overlay kind/aspect conflict"); return -1;
+            }
+        }
+    }
+    s_target = &s_overlay;
+    nv2a_tex_pack_unload();
+    s_overlay = candidate;
+    s_target = &s_base;
+    atomic_fetch_add_explicit(&s_gen, 1u, memory_order_relaxed);
+    return count;
+}
+
+void nv2a_tex_pack_overlay_clear(void)
+{
+    if (!s_overlay.path) return;
+    s_target = &s_overlay;
+    nv2a_tex_pack_unload();
+    s_target = &s_base;
+    atomic_fetch_add_explicit(&s_gen, 1u, memory_order_relaxed);
+}
